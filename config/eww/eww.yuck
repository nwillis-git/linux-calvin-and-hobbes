(include "eww_widgets.yuck")

(defwindow yearbox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "50"
    :y "50"
    :width "100"
    :height "100"
    :anchor "bottom right")
  (yearbox)
)

(defpoll time :interval "1s"  "date '+%H:%M:%S'")
(defpoll date :interval "60s" "date '+%A, %d %B'")

(defwidget clock []
  (box :class "clock"
       :orientation "v"
       :space-evenly false
    (label :class "time" :text time)
    (label :class "date" :text date)))
(defwindow clock
  :monitor "HDMI-A-2"
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "220px"
    :height "90px"
    :anchor "center")
  (clock))

(defwindow monthbox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "170"
    :y "50"
    :width "100"
    :height "100"
    :anchor "bottom right")
  (monthbox)
)

